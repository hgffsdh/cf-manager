# Copy to repo root as .env.aws on AWS. Do NOT commit .env.aws.
# The SQL password must satisfy SQL Server policy and must not contain a semicolon (;),
# which would need escaping within a SQL Server connection string.
# Generate secrets on AWS: openssl rand -hex 32
# In a Compose env file, quote values containing #, $, spaces or other special characters.
SQL_SA_PASSWORD=CHANGE_ME_USE_LONG_STRONG_PASSWORD
JWT_SECRET=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32

# Initial smoke test (HTTP only; DO NOT enter real user passwords):
SITE_ADDRESS=:80
PUBLIC_FRONTEND_URL=http://YOUR_CURRENT_PUBLIC_IPV4

# Once DNS A record points at a stable/Elastic IP, change both to:
# SITE_ADDRESS=cafe.example.com
# PUBLIC_FRONTEND_URL=https://cafe.example.com
