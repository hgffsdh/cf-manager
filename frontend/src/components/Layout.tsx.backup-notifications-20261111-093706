  {
    to: '/admin',
    icon: LayoutDashboard,
    title: 'Tổng quan',
    end: true
  },
  {
    to: '/admin/tables',
    icon: MapPinned,
    title: 'Sơ đồ chòi'
  },
  {
    to: '/admin/orders',
    icon: ClipboardList,
    title: 'Đơn hàng'
  },
  {
    to: '/admin/order-history?status=completed',
    icon: ClipboardList,
    title: 'Lịch sử đơn đã làm'
  },
  {
    to: '/admin/kitchen',
    icon: ChefHat,
    title: 'Pha chế'
  },
  {
    to: '/admin/service',
    icon: ConciergeBell,
    title: 'Phục vụ'
  },
  {
    to: '/admin/menu',
    icon: UtensilsCrossed,
    title: 'Quản lý thực đơn'
  },
  {
    to: '/admin/inventory',
    icon: Boxes,
    title: 'Kho nguyên liệu'
  },
  {
    to: '/admin/team',
    icon: Users,
    title: 'Quản lý nhân viên'
  },
  {
    to: '/admin/reservations',
    icon: CalendarDays,
    title: 'Đặt chòi'
  },
  {
    to: '/admin/reports',
    icon: ChartNoAxesCombined,
    title: 'Báo cáo'
  }
