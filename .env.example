# Copy to .env for the optional Docker demo. NEVER commit .env or use these example values as secrets.
SQL_SA_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
JWT_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ADMIN_EMAIL=owner@moccafe.local
ADMIN_PASSWORD=REPLACE_WITH_STRONG_RANDOM_PASSWORD
PUBLIC_FRONTEND_URL=http://localhost:8082

# REAL MODE. Do NOT enter a fake account. The bank option is disabled unless all 3 are set.
CafeMode__AllowDemoPayments=false
BankTransfer__BankId=
BankTransfer__AccountNo=
BankTransfer__AccountName=
